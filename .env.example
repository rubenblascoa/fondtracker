# ─────────────────────────────────────────────────────
# FondTracker — Configuración de producción (.env.example)
# Copia este fichero a .env y rellena los valores reales.
# NUNCA subas .env a git.
# ─────────────────────────────────────────────────────

# ── Base de datos MySQL ───────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fondtracker_user      # ¡No uses root en producción!
MYSQL_PASSWORD=CAMBIA_ESTO       # Contraseña fuerte
MYSQL_DATABASE=fondtracker
MYSQL_SSL=false                  # true para TiDB Cloud u otra BD gestionada que exija TLS

# ── Servidor HTTP ─────────────────────────────────────
PORT=3741
HOST=127.0.0.1                   # Escucha solo local; expón vía nginx/reverse proxy
NODE_ENV=production

# ── Seguridad ─────────────────────────────────────────
# Genera con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA

# Origen permitido para CORS (tu dominio real, sin barra al final)
# Ejemplo: https://fondtracker.tudominio.com
ALLOWED_ORIGIN=https://TU_DOMINIO

# Si el servidor está detrás de un proxy (nginx, Caddy…) pon 1
# para que el rate limiter use X-Forwarded-For como IP real
TRUST_PROXY=1

# ── WhatsApp vía CallMeBot ────────────────────────────
WHATSAPP_PHONE=+34XXXXXXXXX
CALLMEBOT_API_KEY=TU_API_KEY
WHATSAPP_ENABLED=true
WHATSAPP_TIMEZONE=Europe/Madrid
# Cron en UTC: por defecto 9:00 y 18:00 hora española (UTC+2 verano)
WHATSAPP_DIGEST_CRON="0 7,16 * * *"
WHATSAPP_SEND_INTERVAL_MS=5000

# ── Timeouts ─────────────────────────────────────────
SERVER_IDLE_TIMEOUT_SECONDS=60

# ── Render deployment ─────────────────────────────────
# URL pública del servicio en Render (activa el keep-alive interno)
RENDER_EXTERNAL_URL=https://TU-APP.onrender.com

# Secret para el endpoint de cron externo /api/digest/trigger
# Genera con: openssl rand -hex 32
# Configura un cron externo (cron-job.org, UptimeRobot, GitHub Actions)
# que llame a POST /api/digest/trigger con header X-Cron-Secret: <CRON_SECRET>
CRON_SECRET=CAMBIA_ESTO_POR_UN_SECRET_ALEATORIO

# ── Analíticas (Cloudflare Web Analytics) ──────────────
# Token RUM de tu sitio en Cloudflare (ej. 1dcf4757...)
CLOUDFLARE_BEACON_TOKEN=
